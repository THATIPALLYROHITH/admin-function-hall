rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for authenticated access & mathematical validation
    function isAuthenticated() {
      return request.auth != null;
    }

    function isValidBookingData(data) {
      return data.totalAmount is number 
        && data.totalAmount >= 0
        && data.totalPaid is number 
        && data.totalPaid >= 0
        && data.totalPaid <= data.totalAmount
        && data.balanceAmount == (data.totalAmount - data.totalPaid)
        && (
          (data.totalPaid == 0 && data.paymentStatus == 'Pending') ||
          (data.totalPaid > 0 && data.totalPaid < data.totalAmount && data.paymentStatus == 'Partially Paid') ||
          (data.totalPaid == data.totalAmount && data.paymentStatus == 'Paid')
        )
        && data.bookingStatus in ['Tentative', 'Confirmed', 'Completed', 'Cancelled'];
    }

    // 1. Existing Enquiries Collection (UNCHANGED)
    match /enquiries/{enquiryId} {
      allow read, write: if isAuthenticated();
    }

    // 2. Bookings Collection: Strict Financial & Status Consistency
    match /bookings/{bookingId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isValidBookingData(request.resource.data);
      allow delete: if isAuthenticated();
    }

    // 3. Payments Collection: Immutable Financial Receipts with Safe Void Transition
    match /payments/{paymentId} {
      allow read: if isAuthenticated();
      
      // Creating a new payment
      allow create: if isAuthenticated()
                    && request.resource.data.amount is number
                    && request.resource.data.amount > 0
                    && request.resource.data.paymentMethod in ['Cash', 'UPI', 'Bank Transfer', 'Other']
                    && request.resource.data.status in ['Completed', 'Voided'];
      
      // Controlled update: Monetary amount, date, and bookingId cannot be modified.
      // Only allows transitioning a 'Completed' receipt to 'Voided'.
      allow update: if isAuthenticated()
                    && request.resource.data.amount == resource.data.amount
                    && request.resource.data.paymentDate == resource.data.paymentDate
                    && request.resource.data.bookingId == resource.data.bookingId
                    && request.resource.data.paymentMethod == resource.data.paymentMethod
                    && resource.data.status == 'Completed'
                    && request.resource.data.status == 'Voided';
      
      // Permanent deletion is disabled to guarantee an immutable accounting audit trail
      allow delete: if false;
    }

    // 4. Expenses Collection: Operational & Venue Disbursements
    match /expenses/{expenseId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated()
                            && request.resource.data.amount is number
                            && request.resource.data.amount > 0
                            && request.resource.data.category in [
                              'Electricity', 'Water', 'Maintenance', 'Cleaning', 
                              'Staff', 'Decoration', 'Repairs', 'Marketing', 
                              'Supplies', 'Other'
                            ];
      allow delete: if isAuthenticated();
    }
  }
}
