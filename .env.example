# Firebase Cloud Firestore Environment Configuration (VLNS Gardens Admin)
# Replace placeholder values with your Firebase Web App configuration:
# Firebase Console > Project Settings > General > Your apps > SDK setup and configuration

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=vlns-functional-admin.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=vlns-functional-admin
VITE_FIREBASE_STORAGE_BUCKET=vlns-functional-admin.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id_here
